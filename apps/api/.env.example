# Application
APP_ENV=development

# Volcengine AI audio/video interaction
VOLC_ACCESS_KEY_ID=your-volcengine-access-key-id
VOLC_SECRET_ACCESS_KEY=your-volcengine-secret-access-key
VOLC_RTC_APP_ID=your-volcengine-rtc-app-id
VOLC_RTC_APP_KEY=your-volcengine-rtc-app-key
VOLC_ACCOUNT_ID=your-volcengine-account-id
VOLC_AVATAR_IMAGE_URL=https://example.com/avatar.jpg
VOLC_RTC_ENDPOINT=https://rtc.volcengineapi.com
VOLC_RTC_REGION=cn-north-1
VOLC_RTC_API_VERSION=2025-06-01
VOLC_RTC_TIMEOUT_SECONDS=20
APP_SECRET_KEY=your-app-secret-key
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEMO_MODE=false

# DeepSeek (set DEMO_MODE=false to enable)
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=60
CHAT_HISTORY_TOKEN_BUDGET=12000
CHAT_ATTACHMENT_TOKEN_BUDGET=6000
CHAT_COMPLETION_MAX_TOKENS=4000
AGENT_MAX_ITERATIONS=12
AGENT_CONTEXT_TOKEN_BUDGET=24000
AGENT_TRACE_ENABLED=true
TASK_ACCEPTANCE_MAX_REVISIONS=6
TASK_COMPLETION_MAX_TOKENS=8000
DOCUMENT_REVIEW_ENABLED=true
DOCUMENT_REVIEW_MAX_REVISIONS=2
DOCUMENT_RENDER_ENABLED=true
# Optional absolute path to LibreOffice soffice executable; otherwise resolved from PATH
DOCUMENT_RENDERER_PATH=
DOCUMENT_RENDER_TIMEOUT_SECONDS=45

# Zhipu BigModel: vision understanding and image generation
BIGMODEL_API_KEY=your-bigmodel-api-key
BIGMODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
BIGMODEL_VISION_MODEL=glm-5v-turbo
BIGMODEL_IMAGE_MODEL=glm-image
BIGMODEL_TIMEOUT_SECONDS=120

# V0.2 online search
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=your-tavily-api-key
TAVILY_BASE_URL=https://api.tavily.com
WEB_SEARCH_TIMEOUT_SECONDS=15
WEB_SEARCH_MAX_RESULTS=5

# Recruitment vector search (Qdrant + local FastEmbed)
QDRANT_ENABLED=true
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=recruitment_job_chunks
QDRANT_TIMEOUT_SECONDS=10
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# EMBEDDING_CACHE_DIR=C:/path/to/model-cache

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=aiagent
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=final
