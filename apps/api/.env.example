# Application
APP_ENV=development
APP_SECRET_KEY=your-app-secret-key
APP_CORS_ORIGINS=http://localhost:5173
DEMO_MODE=false

# DeepSeek (set DEMO_MODE=false to enable)
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=60
CHAT_HISTORY_TOKEN_BUDGET=12000
CHAT_ATTACHMENT_TOKEN_BUDGET=6000
CHAT_COMPLETION_MAX_TOKENS=4000

# Zhipu BigModel: vision understanding and image generation
BIGMODEL_API_KEY=your-bigmodel-api-key
BIGMODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
BIGMODEL_VISION_MODEL=glm-5v-turbo
BIGMODEL_IMAGE_MODEL=glm-image
BIGMODEL_TIMEOUT_SECONDS=120

# V0.2 online search
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=your-tavily-api-key
TAVILY_BASE_URL=https://api.tavily.com
WEB_SEARCH_TIMEOUT_SECONDS=15
WEB_SEARCH_MAX_RESULTS=5

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=aiagent
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=final
